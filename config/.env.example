# config/.env

# =====================
# Core Data & Model Paths
# =====================
DATA_PATH=data/comp1884_train_scores.csv
IF_MODEL_PATH=models/if_model.joblib
LSTM_MODEL_PATH=models/lstm_ae_best.h5

# =====================
# Static Thresholds (from COMP1884)
# =====================
STATIC_THRESH_IF=0.03304385848702787
STATIC_THRESH_AE=0.6425
STATIC_THRESH_QUANT_IF=0.03
STATIC_THRESH_QUANT_AE=0.95

# Static anomaly flag columns
STATIC_IF_COL=is_if_anomaly
STATIC_AE_COL=is_lstm_anomaly

# =====================
# Adaptive Threshold Parameters
# =====================

# Window lists can be specified in days (e.g. 14d) or hours (e.g. 336h).
# Bare numbers follow COMBO_WINDOW_UNITS below.
WINDOW_IF_LIST=14d,30d,45d,60d
WINDOW_AE_LIST=14d,30d,45d
PERCENTILES_IF=0.01,0.03
PERCENTILES_AE=0.95,0.975,0.99

# Interpret bare window numbers as 'days' or 'hours'
COMBO_WINDOW_UNITS=days

# Rolling warm-up: 'window' requires a full window; '1' enables thresholds from row 1.
# Use '1' if you want evaluation windows to count every row (no NAs at the start).
ADAPTIVE_MIN_PERIODS=1    # options: window | 1

# =====================
# Global Scope (drives thresholds, sidecar, blends, and counts)
# =====================
# all       -> compute and operate over the full Cartesian product (IF×AE)
# selected  -> only the combos listed in SELECTED_COMBOS
COMBOS_SCOPE=selected          # options: all | selected

# Selected evaluation combos (used when COMBOS_SCOPE=selected)
# Format: w_if:q_if:w_ae:q_ae   (use d/h suffixes for clarity)
SELECTED_COMBOS=45d:0.03:45d:0.975

#,45d:0.01:30d:0.975,45d:0.01:30d:0.99,60d:0.03:45d:0.975,60d:0.01:30d:0.975,45d:0.01:45d:0.99,60d:0.01:45d:0.99,30d:0.03:45d:0.99

# =====================
# Evaluation Windows
# =====================
EVAL_WINDOWS=Calm_2019|2019-05-12|2019-05-24,Calm_2020|2020-04-19|2020-04-25,Event_CiaraDennis|2020-02-05|2020-02-20,Event_Eunice|2022-02-12|2022-02-25

# =====================
# Blending Parameters
# =====================
# List of blend specs to apply, in order.
BLENDS=CAPPED_minmax,DWELL_PATTERN

# --- capped minmax ---
# use:all   -> apply to all combos present in the sidecar (which already reflects COMBOS_SCOPE)
# op:       -> blending operation
# cap:      -> maximum absolute delta applied to adaptive thresholds
BLEND_CAPPED_minmax=use:all;op:capped_minmax;cap:0.02

# --- dwell (pattern-only) ---
# k: number of consecutive AE-true steps required (IF remains unchanged)
BLEND_DWELL_PATTERN=use:all;op:dwell_pattern;k:3


# =====================
# Confidence Scoring (Percentile Rank)
# =====================
# Goal: produce a continuous [0,1] confidence score per timestamp, per combo-of-interest.
# Uses the SAME rolling window and min_periods as the adaptive thresholds.
# For each model:
#   IF -> confidence uses LOWER tail (more anomalous = smaller scores).
#   AE -> confidence uses UPPER tail (more anomalous = larger errors).
# For each timestamp's anomaly type:
#   Compound -> mean(IF_conf, AE_conf)
#   Point    -> IF_conf
#   Pattern  -> AE_conf
#   None     -> no emission

# Master switch
CONF_ENABLED=1                    # 1=on, 0=off

# Method for turning scores into confidence within each rolling window
CONF_METHOD=percentile_rank       # options: percentile_rank | zscore (reserved)

# Tail configuration per model (controls which side of the CDF maps to "more anomalous")
CONF_TAIL_IF=low                  # low -> conf = 1 - rank(score)
CONF_TAIL_AE=high                 # high -> conf = rank(score)

# Warm-up policy (inherits the adaptive setting so windows align exactly)
CONF_MIN_PERIODS=inherit          # options: inherit | window | 1

# Window source for confidence (always use the model’s combo window so it mirrors thresholds)
CONF_WINDOW_SOURCE=combo          # options: combo (use w_if / w_ae from combo)

# Numerical safety / clipping
CONF_EPS=1e-9                     # avoids exact 0/1 due to ties/finite windows
CONF_CLIP_MIN=0.001               # final clipping after EPS
CONF_CLIP_MAX=0.999

# Emission policy by anomaly type (controls which final per-timestamp confidence to output)
CONF_EMIT_TYPES=Point,Pattern,Compound   # valid: None,Point,Pattern,Compound

# Aggregation for Compound
CONF_COMPOUND_AGG=mean           # options: mean | min | max | harmonic (future)

# Source selection for non-compound anomaly types
CONF_POINT_SOURCE=IF             # options: IF | AE
CONF_PATTERN_SOURCE=AE           # options: IF | AE

# Respect the global combos scope (confidence is computed ONLY for combos already present)
CONF_SCOPE_RESPECTS_COMBOS=1     # 1=compute only for combos generated by thresholds

# Output naming
CONF_COL_PREFIX=conf             # e.g., conf__wIF45d_qIF0.03__wAE45d_qAE0.975 (final per-timestamp)

# Switch confidence scoring methods: combo-quantile based / actual-threshold-based
CONF_IMPL=qt    # options: combo | qt
